+        return root;
+    }
+    Value autoCall(IxeHandle value) {
+        IxeHandle result = 0;
+        checked(ixe_auto_call(session.get(), value, &result));
+        return {session.get(), result};
+    }
+    int type(IxeHandle value) {
+        checked(ixe_force(session.get(), value));
+        return ixe_value_type(session.get(), value);
+    }
+    Value select(IxeHandle value, const std::string &name) {
+        IxeHandle result = 0;
+        int rc = ixe_attrs_select(session.get(), value, bytes(name).text,
+                                  name.size(), &result);
+        if (rc == IXE_ERR_MISSING) {
+            Text discarded;
+            discarded.data = ixe_session_take_error(session.get(), nullptr);
+            throw nix::AttrPathNotFound("attribute '%s' not found", name);
+        }
+        checked(rc);
+        return {session.get(), result};
+    }
+    std::optional<Value> optional(IxeHandle value, const std::string &name) {
+        try {
+            return select(value, name);
+        } catch (nix::AttrPathNotFound &) {
+            return std::nullopt;
+        }
+    }
+    std::vector<std::string> names(IxeHandle value) {
+        char *data = nullptr;
+        size_t size = 0;
+        checked(ixe_attrs_names(session.get(), value, &data, &size));
+        std::unique_ptr<char, std::function<void(char *)>> owner(
+            data, [size](char *p) { ixe_names_free(p, size); });
+        std::vector<std::string> result;
+        for (size_t i = 0; i < size;) {
+            size_t n = strnlen(data + i, size - i);
+            result.emplace_back(data + i, n);
+            i += n + 1;
+        }
+        return result;
+    }
+    Value walk(IxeHandle value, const std::vector<std::string> &path,
+               bool indexLists = true) {
+        auto current = autoCall(value);
+        for (const auto &name : path) {
+            type(current.handle);
+            const auto index =
+                indexLists ? nix::string2Int<unsigned int>(name) : std::nullopt;
+            if (index) {
+                IxeHandle next = 0;
+                checked(
+                    ixe_list_at(session.get(), current.handle, *index, &next));
+                current = Value(session.get(), next);
+            } else {
+                if (name.empty())
+                    throw nix::AttrPathNotFound(
+                        "empty attribute name in selection path");
+                current = select(current.handle, name);
+            }
+            current = autoCall(current.handle);
+        }
+        type(current.handle);
+        return current;
+    }
+    std::string string(IxeHandle value, bool allowContext = false) {
+        Text result;
+        if (allowContext)
+            checked(
+                ixe_render(session.get(), value, IXE_RENDER_RAW, &result.data));
+        else {
+            if (type(value) != IXE_TYPE_STRING)
+                throw nix::TypeError(state, "expected a string without context");
+            checked(ixe_get_string(session.get(), value, &result.data));
+        }
+        return result.str();
+    }
+    std::string storePath(IxeHandle value) {
+        auto coerced = apply(storeCoercer, value);
+        return string(coerced.handle, true);
+    }
+    bool boolean(IxeHandle value) {
+        int result = 0;
+        checked(ixe_get_bool(session.get(), value, &result));
+        return result != 0;
+    }
+    nlohmann::json json(IxeHandle value) {
+        Text result;
+        checked(
+            ixe_render(session.get(), value, IXE_RENDER_JSON, &result.data));
+        return nlohmann::json::parse(result.str());
+    }
+    std::vector<Value> list(IxeHandle value) {
+        size_t n = 0;
+        checked(ixe_list_len(session.get(), value, &n));
+        std::vector<Value> result;
+        for (size_t i = 0; i < n; ++i) {
+            IxeHandle item = 0;
+            checked(ixe_list_at(session.get(), value, i, &item));
+            result.emplace_back(session.get(), item);
+        }
+        return result;
+    }
+    Value apply(const Value &function, IxeHandle argument) {
+        closeQuestion();
+        IxeHandle result = 0;
+        checked(ixe_apply(session.get(), function.handle, argument, &result));
+        Value owned(session.get(), result);
+        jobsQuestion();
+        return owned;
+    }
+    std::vector<std::string> context(IxeHandle value) {
+        auto coerced = apply(coercer, value);
+        type(coerced.handle);
+        char *data = nullptr;
+        size_t size = 0;
+        checked(ixe_get_string_context(session.get(), coerced.handle, &data,
+                                       &size));
+        std::unique_ptr<char, std::function<void(char *)>> owner(
+            data, [size](char *p) { ixe_names_free(p, size); });
+        std::vector<std::string> result;
+        for (size_t i = 0; i < size;) {
+            size_t n = strnlen(data + i, size - i);
+            result.emplace_back(data + i, n);
+            i += n + 1;
+        }
+        return result;
+    }
+};
