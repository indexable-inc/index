+auto Drv::fromTypedValues(nix::EvalState &state, MyArgs &args,
+    std::string name, std::string system, nix::StorePath drvPath,
+    std::map<std::string, std::optional<nix::StorePath>> outputs,
+    std::optional<nlohmann::json> meta, Constituents constituents) -> Drv {
+    auto store=state.store;
+    Drv result{.name=std::move(name), .storeDir=store->storeDir,
+        .system=std::move(system), .drvPath=std::move(drvPath),
+        .outputs=std::move(outputs), .neededBuilds={}, .neededSubstitutes={},
+        .unknownPaths={}, .meta=std::move(meta), .constituents=std::move(constituents)};
+    auto local=store.dynamic_pointer_cast<nix::LocalFSStore>();
+    if (local && !nix::settings.readOnlyMode) {
+        auto drv=local->readDerivation(result.drvPath);
+        result.system=drv.platform;
+        if (args.checkCacheStatus)
+            result.cacheStatus=queryCacheStatus(*store,result.outputs,result.neededBuilds,
+                result.neededSubstitutes,result.unknownPaths,drv);
+        if (args.showInputDrvs) result.inputDrvs=queryInputDrvs(drv);
+        auto options=derivationOptionsFromStructuredAttrs(*store,drv.env,get(drv.structuredAttrs));
+        result.requiredSystemFeatures=options.getRequiredSystemFeatures(drv);
+    }
+    return result;
+}
