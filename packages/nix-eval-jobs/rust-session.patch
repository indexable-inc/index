+#pragma once
+
+#include "ixe.h"
+#include <cstring>
+#include <filesystem>
+#include <functional>
+#include <memory>
+#include <nix/cmd/rust-eval-session.hh>
+#include <nix/expr/attr-path.hh>
+#include <nix/expr/eval-settings.hh>
+#include <nix/util/strings.hh>
+#include <nlohmann/json.hpp>
+#include <optional>
+#include <utility>
