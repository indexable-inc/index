+namespace nix_eval_jobs {
+
+struct Value {
+    IxeSession *session = nullptr;
+    IxeHandle handle = 0;
+    Value() = default;
+    Value(IxeSession *session_, IxeHandle handle_)
+        : session(session_), handle(handle_) {}
+    Value(const Value &) = delete;
+    Value &operator=(const Value &) = delete;
+    Value(Value &&other) noexcept
+        : session(other.session), handle(std::exchange(other.handle, 0)) {}
+    Value &operator=(Value &&other) noexcept {
+        if (this != &other) {
+            if (handle)
+                ixe_handle_free(session, handle);
+            session = other.session;
+            handle = std::exchange(other.handle, 0);
+        }
+        return *this;
+    }
+    ~Value() {
+        if (handle)
+            ixe_handle_free(session, handle);
+    }
+};
+
+struct Text {
+    char *data = nullptr;
+    Text() = default;
+    Text(const Text &) = delete;
+    ~Text() { ixe_string_free(data); }
+    std::string str() const { return data ? data : ""; }
+};
+
+// One host and VM per child worker, created after fork and kept until the
+// existing memory-limit restart. Values never cross the parent/worker pipe.
+class Session {
+    nix::EvalState &state;
+    nix::RustEvalSetup setup;
+    std::unique_ptr<IxeSession, decltype(&ixe_session_free)> session;
+    std::vector<nix::RustAutoArg> autoArgs;
+    std::string originalSource;
+    std::string sourceRoot;
+    Value coercer;
+    Value storeCoercer;
+
+    static IxeBytes bytes(const std::string &s) {
+        return {reinterpret_cast<const unsigned char *>(s.data()), s.size()};
+    }
+
+    Value question(const nix::RustEvaluand &input) {
+        std::vector<IxeArgument> arguments;
+        for (const auto &a : input.args)
+            arguments.push_back({a.kind == nix::RustArgument::Kind::Json
+                                     ? IXE_ARG_JSON
+                                     : IXE_ARG_INTERNAL_PRIMOP,
+                                 bytes(a.text)});
+        std::vector<IxeAutoArg> supplied;
+        for (const auto &a : autoArgs)
+            supplied.push_back({bytes(a.name),
+                                a.kind == nix::RustAutoArg::Kind::Expr
+                                    ? IXE_AUTO_ARG_EXPR
+                                    : IXE_AUTO_ARG_STRING,
+                                bytes(a.text)});
+        const std::string empty;
+        const IxeBytes rootPath = bytes(empty);
+        IxeHandle root = 0;
+        Text answer;
+        int mode = -1;
+        // Root configuration must follow abandonment of the previous job.
+        // eval_question also abandons, but that is too late for this setter.
+        closeQuestion();
+        checked(ixe_session_set_source_root(
+            session.get(), bytes(input.src.root).text, input.src.root.size()));
+        checked(ixe_session_eval_question(
+            session.get(), bytes(input.src.source).text,
+            input.src.source.size(), bytes(input.src.baseDir).text,
+            input.src.baseDir.size(),
+            input.src.file.empty() ? nullptr : bytes(input.src.file).text,
+            input.src.file.size(), arguments.data(), arguments.size(),
+            IXE_QUESTION_SELECT, &rootPath, 1, 1, nullptr, 0, supplied.data(),
+            supplied.size(), 0, IXE_RENDER_JSON, &mode, &root, &answer.data));
+        // This worker's streaming replies are not a nix eval memo answer.
+        // The result cache is disabled in this dedicated child, so no foreign
+        // answer shape is read, removed or filed under SELECT's cache kind.
+        Value owned(session.get(), root);
+        if (mode != IXE_SERVE_EVALUATE || answer.data)
+            throw nix::Error(
+                "nix-eval-jobs unexpectedly received a memoized answer");
+        return owned;
+    }
+
+  public:
+    Session(nix::EvalState &state_, const nix::MixEvalArgs &args)
+        : state(state_), setup(state_), session(nullptr, &ixe_session_free),
+          autoArgs(nix::rustAutoArgsOf(args)) {
+        // In-memory compiled modules and graph cells remain resident for this
+        // worker. Do not impersonate the nix executable's persistent cache
+        // identity.
+        ixe_set_eval_cache_dir(nullptr, 0);
+        session.reset(ixe_session_new(setup.host()));
+        if (!session) {
+            Text error;
+            error.data = ixe_take_setting_conflict();
+            throw nix::Error("cannot create nix-eval-jobs Rust session: %s",
+                             error.str());
+        }
+        coercer = expression("x: builtins.toString x");
+        // coerceToStorePath uses coerceMore=false and copyToStore=false.
+        // Generic toString would also accept lists, numbers and booleans.
+        storeCoercer = expression(R"nix(
+          let coerce = value:
+            let kind = builtins.typeOf value; in
+            if kind == "string" then value
+            else if kind == "path" then builtins.toString value
+            else if kind == "set" && value ? __toString then coerce (value.__toString value)
+            else if kind == "set" && value ? outPath then coerce value.outPath
+            else throw "cannot coerce ${kind} to a store path";
+          in coerce
+        )nix");
+    }
+    ~Session() { closeQuestion(); }
+    Session(const Session &) = delete;
+
+    void checked(int status) {
+        if (!status)
+            return;
+        IxePos at{nullptr, 0, 0};
+        Text error;
+        error.data = ixe_session_take_error(session.get(), &at);
+        Text file;
+        file.data = at.file;
+        auto pos = nix::rustEvalPos(state, originalSource, file.data, at.line,
+                                    at.column);
+        const char *token = ixe_session_refusal_token(session.get());
+        nix::rustEvalThrow(state, status, error.str(),
+                           token ? token : "unrecorded", pos);
+    }
+    void closeQuestion() noexcept {
+        if (session)
+            // Any nonzero status abandons without filing (public ixe.h contract).
+            ixe_session_question_answer(session.get(), 1, nullptr, 0);
+    }
+    void jobsQuestion() {
+        nix::RustEvaluand dummy;
+        dummy.src = {.source = "null",
+                     .baseDir =
+                         nix::absPath(std::filesystem::path(".")).string(),
+                     .file = "",
+                     .root = sourceRoot};
+        auto unused = question(dummy);
+    }
+    Value expression(const std::string &source) {
+        IxeHandle value = 0;
+        const auto base = nix::absPath(std::filesystem::path(".")).string();
+        checked(ixe_session_eval(session.get(), bytes(source).text,
+                                 source.size(), bytes(base).text, base.size(),
+                                 nullptr, 0, &value));
+        return {session.get(), value};
+    }
+    Value initialize(const nix::RustEvaluand &input, bool autoCallRoot) {
+        originalSource = input.src.source;
+        sourceRoot = input.src.root;
+        auto root = question(input);
+        if (autoCallRoot)
+            root = autoCall(root.handle);
+        // Resolve the normal flake constructor's quoted candidate paths without
+        // auto-calling flake attributes. Non-flake roots are auto-called above.
+        for (const auto &path : input.attrPaths) {
+            if (path.empty()) {
+                closeQuestion();
+                return root;
+            }
+            try {
+                Value selected;
+                IxeHandle current = root.handle;
+                for (const auto &part : nix::parseAttrPath(path)) {
+                    type(current);
+                    selected = select(current, part);
+                    current = selected.handle;
+                }
+                closeQuestion();
+                return selected;
+            } catch (nix::AttrPathNotFound &) {
+                if (path == input.attrPaths.back())
+                    throw;
+            }
