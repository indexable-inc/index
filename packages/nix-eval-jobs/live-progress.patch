+// Opt-in controller events share the JSONL output lock with completed jobs.
+// Only the collector knows both the assigned attribute and its worker process.
+void evaluationProgress(const char *event, int worker, const nlohmann::json &path) {
+    const char *enabled = std::getenv("JJ_EVAL_PROGRESS");
+    if (enabled == nullptr || std::string_view(enabled) != "1") return;
+    const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    const nlohmann::json record = {{"type", "evaluation-progress"},
+        {"event", event}, {"worker", worker}, {"attrPath", path}, {"at_ms", now}};
+    getCoutLock().lock() << record.dump() << "\n";
+}
