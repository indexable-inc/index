# vim: filetype=meson

option(
  'host-build-identity',
  type : 'string',
  value : '',
  description : 'immutable CLI and host dependency identity for persistent evaluation caching',
)

# A relative path means it gets appended to prefix.
option(
  'profile-dir',
  type : 'string',
  value : 'etc/profile.d',
  description : 'the path to install shell profile files',
)
