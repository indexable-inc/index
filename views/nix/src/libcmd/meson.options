# vim: filetype=meson

option(
  'markdown',
  type : 'feature',
  description : 'Enable Markdown rendering in the Nix binary (requires lowdown)',
)

option(
  'rust-eval-prefix',
  type : 'string',
  value : '',
  description : 'prefix of the shared nix-eval-rs runtime; empty discovers the dependency provided by libflake',
)
